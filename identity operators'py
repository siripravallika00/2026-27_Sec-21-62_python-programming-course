#identity operators exercises
#is
a=[1,2,3]
b=a
result= a is b # identity operator  
print("Result of ",a,"is",b,"is",result)

a= [1,2,3]
b= [1,2,3]  
result= a is b # identity operator
print("Result of ",a,"is",b,"is :",result)

#is not
a= [1,2,3]
b= [1,5,3]
result= a is not b # identity operator
print("Result of ",a,"is not",b,"is :",result)

a= [1,2,3]
b=a
result= a is not b # identity operator
print("Result of ",a,"is not",b,"is :",result)


 